# Core controls
AUTOMATION_ENABLED=true
KEEP_CHROME_OPEN=true

# Chrome/CDP
CHROME_EXECUTABLE_PATH=
CHROME_DEBUG_PORT=9222
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_USER_DATA_DIR=./data/chrome-profile

# SQLite
SQLITE_DB_PATH=./data/jobs.db

# Scheduling
SEARCH_INTERVAL_MINUTES=15

# Discovery behavior
SEARCH_LAST_24H_ONLY=true
APPLICATION_SCORE_THRESHOLD=60

# Telegram delivery
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_RELEVANT_JOBS_CHAT_ID=
TELEGRAM_NON_RELEVANT_JOBS_CHAT_ID=
TELEGRAM_RELEVANT_SCORE_THRESHOLD=30

# Format: keyword|location;keyword|location
SEARCH_QUERIES=Java Software Engineer|Egypt
